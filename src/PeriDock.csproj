<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PeriDock</AssemblyName>
    <Product>Peripheral Battery</Product>
    <Title>Peripheral Battery</Title>
    <Description>Peripheral battery levels and mouse DPI</Description>
    <Version>0.2.0-preview.4</Version>
    <StartupObject>PeriDock.Program</StartupObject>
    <ApplicationIcon>..\assets\peridock.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="official-products.json" />
    <Compile Remove="tests\**" />
    <Compile Remove="ui-checks\**" />
    <InternalsVisibleTo Include="PeriDock.UiChecks"/>
    <InternalsVisibleTo Include="PeriDock.Tests"/>
    <Content Include="..\assets\**\*.png;..\assets\**\*.ico;..\assets\**\*.svg">
      <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Using Include="System"/>
    <Using Include="System.Collections.Generic"/>
    <Using Include="System.Linq"/>
    <Using Include="System.Threading"/>
    <Using Include="System.Threading.Tasks"/>
  </ItemGroup>
</Project>
