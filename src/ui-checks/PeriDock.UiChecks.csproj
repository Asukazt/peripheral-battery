<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PeriDock.UiChecks</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PeriDock.csproj"/>
    <Content Include="status.sample.json" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="..\..\assets\**\*.png;..\..\assets\**\*.ico;..\..\assets\**\*.svg">
      <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
